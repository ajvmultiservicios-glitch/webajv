---
/**
 * Página de contacto: datos directos, formulario, sedes con mapa.
 */
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactForm from '@/components/ContactForm.astro';
import SedeCard from '@/components/SedeCard.astro';
import { SITE, WHATSAPP_URL } from '@/config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contacto — ${SITE.nombre}`,
  url: new URL('/contacto/', SITE.url).toString(),
};
---

<BaseLayout
  title="Contacto"
  description={`Contáctanos: teléfonos ${SITE.telefonos.join(' / ')}, correo ${SITE.emails[0]} o WhatsApp. Cotizaciones en menos de 24 horas hábiles.`}
  jsonLd={jsonLd}
>
  <PageHeader
    titulo="Contáctenos"
    descripcion="Cuéntanos tu requerimiento y te responderemos en menos de 24 horas hábiles."
  />

  <section class="seccion fondo-hex">
    <div class="contenedor grid gap-12 lg:grid-cols-2">
      <!-- Datos de contacto -->
      <div>
        <h2 class="font-titulo text-2xl font-bold text-primario-800">Hablemos de tu proyecto</h2>
        <p class="mt-3 leading-relaxed text-tinta-suave">
          Atendemos proyectos metalmecánicos para industria y minería en todo el Perú.
        </p>

        <ul class="mt-8 space-y-5">
          <li class="flex items-start gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-marca bg-primario-50 text-primario-700">
              <Icon name="mdi:phone" class="size-6" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-semibold">Teléfonos</h3>
              {SITE.telefonos.map((t) => (
                <a href={`tel:+51${t.replace(/\s/g, '')}`} class="block text-sm text-tinta-suave hover:text-primario-700">
                  {t}
                </a>
              ))}
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-marca bg-primario-50 text-primario-700">
              <Icon name="mdi:email-outline" class="size-6" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-semibold">Correos</h3>
              {SITE.emails.map((e) => (
                <a href={`mailto:${e}`} class="block text-sm text-tinta-suave hover:text-primario-700">
                  {e}
                </a>
              ))}
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-marca bg-primario-50 text-primario-700">
              <Icon name="mdi:whatsapp" class="size-6" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-semibold">WhatsApp</h3>
              <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="text-sm text-tinta-suave hover:text-primario-700">
                Escríbenos ahora y recibe respuesta inmediata
              </a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-marca bg-primario-50 text-primario-700">
              <Icon name="mdi:clock-outline" class="size-6" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-semibold">Horario de atención</h3>
              <p class="text-sm text-tinta-suave">{SITE.sedes[0].horario}</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Formulario -->
      <div class="tarjeta p-6 sm:p-8">
        <h2 class="font-titulo text-xl font-bold">Envíanos un mensaje</h2>
        <div class="mt-6">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Sedes (banda oscura diagonal) -->
  <section class="banda-diagonal bg-fondo-oscuro fondo-hex-claro text-white">
    <div class="contenedor">
      <h2 class="text-center font-titulo text-2xl font-bold !text-secundario-400">¿Dónde estamos?</h2>
      <div class="mt-10 grid gap-8 lg:grid-cols-1">
        {SITE.sedes.map((s) => (
          <SedeCard sede={s} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
