---
/**
 * Página "Equipos": maquinaria y equipos principales del taller,
 * con sus especificaciones técnicas.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SITE } from '@/config/site';
import tornoImg from '@/assets/equipos/torno-horizontal.jpg';
import prensaImg from '@/assets/equipos/prensa-hidraulica.jpg';
import barrenadoraImg from '@/assets/equipos/barrenadora-climax.jpg';
import soldadoraImg from '@/assets/equipos/soldadora-miller.jpg';
import fresadoraImg from '@/assets/equipos/fresadora-correa-f3ua.jpg';

/** Maquinaria principal del taller con sus especificaciones. */
const equipos = [
  {
    nombre: 'Torno horizontal de 1500 mm de bancada',
    imagen: tornoImg,
    alt: 'Torno horizontal paralelo de 1500 mm de bancada en el taller de AJV',
    descripcion:
      'Torno paralelo de bancada rígida para el mecanizado de ejes, bocinas, acoples, poleas y componentes cilíndricos de gran tamaño. Su robustez permite trabajos de desbaste y acabado con alta precisión dimensional.',
    specs: [
      { label: 'Distancia entre puntos', valor: '1.500 mm de bancada' },
      { label: 'Volteo sobre bancada', valor: '~460 mm (volteo sobre escote ~690 mm)' },
      { label: 'Velocidad del husillo', valor: 'rango amplio para desbaste y acabado (20 – 2.000 rpm)' },
      { label: 'Potencia del motor', valor: '~7,5 HP' },
      { label: 'Aplicaciones', valor: 'ejes, bocinas, bridas, acoples y roscados' },
    ],
  },
  {
    nombre: 'Prensa hidráulica de 200 toneladas',
    imagen: prensaImg,
    alt: 'Prensa hidráulica de taller tipo H de AJV',
    descripcion:
      'Prensa de estructura tipo "H" en acero de alta resistencia, para operaciones de montaje y desmontaje de rodamientos y bocinas, enderezado de ejes y planchas, y conformado de componentes mecánicos de grandes dimensiones.',
    specs: [
      { label: 'Capacidad', valor: '200 toneladas de fuerza de prensado' },
      { label: 'Estructura', valor: 'marco tipo "H" de acero de alta resistencia, gran rigidez' },
      { label: 'Sistema hidráulico', valor: 'bomba hidráulica, cilindro y retorno automático del pistón' },
      { label: 'Mesa regulable', valor: 'altura de mesa ajustable según el tamaño de la pieza' },
      { label: 'Seguridad', valor: 'válvula de seguridad integrada y manómetro de control' },
      { label: 'Aplicaciones', valor: 'montaje/desmontaje a presión, enderezado y conformado' },
    ],
  },
  {
    nombre: 'Barrenadora hidráulica CLIMAX',
    imagen: barrenadoraImg,
    alt: 'Barrenadora portátil CLIMAX para mecanizado in situ',
    descripcion:
      'Equipo portátil de barrenado en línea (line boring) para recuperar alojamientos de pines, bujes y rodamientos directamente en campo, sin necesidad de desmontar ni trasladar componentes de gran tamaño.',
    specs: [
      { label: 'Diámetros de barrenado', valor: '38 – 610 mm (1,5" – 24")' },
      { label: 'Carrera máxima', valor: 'hasta 914 mm (36")' },
      { label: 'Velocidad del husillo', valor: '10 – 180 rpm según configuración' },
      { label: 'Accionamiento', valor: 'hidráulico, ideal para trabajo en campo' },
      { label: 'Aplicaciones', valor: 'alojamientos de cucharones, plumas, chasis y bastidores' },
    ],
  },
  {
    nombre: 'Máquinas de soldar MILLER de 600 A',
    imagen: soldadoraImg,
    alt: 'Máquina de soldar Miller de 600 amperios en operación',
    descripcion:
      'Soldadoras industriales multiproceso de alto amperaje para soldadura de estructuras pesadas y recuperación de componentes, con capacidad de trabajo continuo en taller y en campo.',
    specs: [
      { label: 'Corriente máxima', valor: '600 A al 60 % de ciclo de trabajo' },
      { label: 'Trabajo continuo', valor: '500 A al 100 % de ciclo de trabajo' },
      { label: 'Procesos', valor: 'electrodo revestido (SMAW), MIG, alambre tubular (FCAW) y TIG' },
      { label: 'Energía auxiliar', valor: 'generador para herramientas y equipos en campo' },
      { label: 'Aplicaciones', valor: 'estructuras pesadas, recargue duro y reparación de componentes' },
    ],
  },
  {
    nombre: 'Fresadora CORREA F3UA',
    imagen: fresadoraImg,
    alt: 'Fresadora universal Correa F3UA del taller de AJV',
    descripcion:
      'Fresadora universal de fabricación española, reconocida por su estructura de fundición pesada que reduce drásticamente las vibraciones durante el mecanizado de chaveteros, engranajes, guías y superficies planas.',
    specs: [
      { label: 'Superficie de la mesa', valor: '1.400 × 340 mm con ranuras en T para amarre de piezas grandes' },
      { label: 'Recorrido eje X (longitudinal)', valor: '1.100 mm' },
      { label: 'Recorrido eje Y (transversal)', valor: '~310 – 320 mm' },
      { label: 'Recorrido eje Z (vertical)', valor: '~485 – 500 mm' },
      { label: 'Potencia del motor', valor: '~7,5 CV (5,5 – 7 kW)' },
      { label: 'Peso aproximado', valor: '3.250 – 3.600 kg de fundición pesada' },
    ],
  },
];
---

<BaseLayout
  title="Nuestros equipos"
  description={`Maquinaria de ${SITE.nombre}: torno horizontal de 1500 mm, prensa hidráulica, barrenadora CLIMAX, soldadoras Miller de 600 A y fresadora Correa F3UA.`}
>
  <PageHeader
    titulo="Nuestros equipos"
    descripcion="Maquinaria industrial propia para fabricar, mecanizar y recuperar componentes con precisión, en taller y en campo."
  />

  <!-- Listado de maquinaria -->
  <section class="seccion fondo-hex">
    <div class="contenedor">
      <SectionHeading
        etiqueta="Maquinaria"
        titulo="Equipos que respaldan cada proyecto"
        descripcion="Contamos con máquinas-herramienta y equipos de soldadura industriales que nos permiten garantizar calidad, precisión y tiempos de entrega."
      />

      <div class="mt-14 space-y-16">
        {equipos.map((e, i) => (
          <article class="grid items-center gap-10 lg:grid-cols-2">
            <div class={`revelar drop-shadow-xl ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
              <Image
                src={e.imagen}
                alt={e.alt}
                width={900}
                height={640}
                class="w-full rounded-marca border border-borde bg-white object-cover"
              />
            </div>
            <div class={`revelar ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
              <h2 class="text-2xl font-bold sm:text-3xl">{e.nombre}</h2>
              <p class="mt-4 leading-relaxed text-tinta-suave">{e.descripcion}</p>
              <ul class="mt-6 space-y-2.5">
                {e.specs.map((s) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed">
                    <Icon name="mdi:check-circle-outline" class="mt-0.5 size-5 shrink-0 text-secundario-500" aria-hidden="true" />
                    <span class="text-tinta-suave"><strong class="text-tinta">{s.label}:</strong> {s.valor}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    titulo="¿Tu proyecto necesita esta capacidad instalada?"
    descripcion="Cuéntanos qué necesitas fabricar o recuperar y te enviaremos una propuesta técnica."
  />
</BaseLayout>
