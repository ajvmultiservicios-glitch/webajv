---
/**
 * Tarjeta de sede: datos de contacto + mapa de Google Maps incrustado
 * (carga diferida con loading="lazy").
 */
import { Icon } from 'astro-icon/components';
import type { Sede } from '@/config/site';

export interface Props {
  sede: Sede;
}
const { sede } = Astro.props;
---

<article class="tarjeta revelar grid overflow-hidden lg:grid-cols-5">
  <div class="p-6 sm:p-8 lg:col-span-2">
    <h3 class="text-2xl">{sede.nombre}</h3>
    <ul class="mt-5 space-y-4 text-tinta-suave">
      <li class="flex gap-3">
        <Icon name="mdi:map-marker-outline" class="size-6 shrink-0 text-secundario-600" aria-hidden="true" />
        <span>{sede.direccion}<br />{sede.ciudad}, {sede.pais}</span>
      </li>
      <li class="flex gap-3">
        <Icon name="mdi:phone-outline" class="size-6 shrink-0 text-secundario-600" aria-hidden="true" />
        <a href={`tel:${sede.telefono.replace(/[^\d+]/g, '')}`} class="hover:text-primario-700">{sede.telefono}</a>
      </li>
      <li class="flex gap-3">
        <Icon name="mdi:clock-outline" class="size-6 shrink-0 text-secundario-600" aria-hidden="true" />
        <span>{sede.horario}</span>
      </li>
    </ul>
    <a href={sede.mapaLink} target="_blank" rel="noopener noreferrer" class="btn btn-primario mt-6">
      <Icon name="mdi:directions" class="size-5" aria-hidden="true" />
      Cómo llegar
    </a>
  </div>
  <div class="min-h-72 bg-primario-50 lg:col-span-3">
    <iframe
      src={sede.mapaEmbed}
      title={`Mapa de ubicación: ${sede.nombre}`}
      class="h-full min-h-72 w-full border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
</article>
