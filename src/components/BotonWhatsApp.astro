---
/** Botón flotante de WhatsApp (esquina inferior derecha). */
import { Icon } from 'astro-icon/components';
import { WHATSAPP_URL } from '@/config/site';
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  class="fixed bottom-5 right-5 z-40 inline-flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/25 transition-transform hover:scale-110 focus-visible:scale-110"
>
  <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-60 animate-ping motion-reduce:hidden" aria-hidden="true"></span>
  <Icon name="mdi:whatsapp" class="relative size-8" aria-hidden="true" />
</a>
