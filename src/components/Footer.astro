---
/**
 * Pie de página: logo + descripción, enlaces rápidos, servicios,
 * datos de contacto, redes sociales y enlaces legales.
 */
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { SITE, WHATSAPP_URL, telHref } from '@/config/site';
import logoBlanco from '@/assets/logo.png';

const anio = new Date().getFullYear();
const sede = SITE.sedes[0];
---

<footer class="bg-fondo-oscuro text-white/85 mt-auto">
  <div class="contenedor seccion !pb-10">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Marca -->
      <div>
        <a href="/" class="inline-block" aria-label={`${SITE.nombreCorto} — Inicio`}>
          <Image src={logoBlanco} alt={`Logo de ${SITE.nombreCorto}`} width={220} height={89} densities={[1, 2, 3]} quality={90} class="h-20 w-auto" />
        </a>
        <p class="mt-4 text-sm leading-relaxed">{SITE.descripcion}</p>
        <ul class="mt-5 flex items-center gap-2" aria-label="Redes sociales">
          {SITE.redes.map((r) => (
            <li>
              <a
                href={r.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={r.nombre}
                class="inline-flex size-10 items-center justify-center rounded-full bg-white/10 hover:bg-secundario-500 hover:text-primario-900 transition-colors"
              >
                <Icon name={r.icono} class="size-5" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Enlaces rápidos -->
      <nav aria-label="Enlaces rápidos">
        <h2 class="font-titulo text-base font-bold !text-secundario-400 uppercase tracking-wide">Enlaces</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {SITE.navegacion.map((item) => (
            <li>
              <a href={item.href} class="inline-flex items-center gap-2 hover:text-secundario-300 transition-colors">
                <Icon name="mdi:chevron-right" class="size-4 text-secundario-400" aria-hidden="true" />
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Servicios -->
      <nav aria-label="Servicios">
        <h2 class="font-titulo text-base font-bold !text-secundario-400 uppercase tracking-wide">Servicios</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {SITE.servicios.map((s) => (
            <li>
              <a href={`/servicios/${s.slug}/`} class="inline-flex items-center gap-2 hover:text-secundario-300 transition-colors">
                <Icon name="mdi:chevron-right" class="size-4 text-secundario-400" aria-hidden="true" />
                {s.titulo}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contacto -->
      <address class="not-italic" itemscope itemtype="https://schema.org/LocalBusiness" aria-labelledby="footer-contacto-titulo">
        <meta itemprop="name" content={SITE.nombre} />
        <meta itemprop="url" content={SITE.url} />
        <h2 id="footer-contacto-titulo" class="font-titulo text-base font-bold !text-secundario-400 uppercase tracking-wide">Contacto</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex gap-2" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
            <Icon name="mdi:map-marker-outline" class="size-5 shrink-0 text-secundario-400" aria-hidden="true" />
            <span>
              <span itemprop="streetAddress">{sede.direccion}</span>, <span itemprop="addressLocality">{sede.ciudad}</span>, <span itemprop="addressCountry">{sede.pais}</span>
            </span>
          </li>
          {SITE.telefonos.map((t, i) => (
            <li class="flex gap-2">
              <Icon name="mdi:phone-outline" class="size-5 shrink-0 text-secundario-400" aria-hidden="true" />
              <a href={telHref(t)} itemprop="telephone" class="hover:text-secundario-300" aria-label={`Llamar al teléfono ${i + 1}: ${t}`}>{t}</a>
            </li>
          ))}
          <li class="flex gap-2">
            <Icon name="mdi:whatsapp" class="size-5 shrink-0 text-secundario-400" aria-hidden="true" />
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="hover:text-secundario-300">WhatsApp: +{SITE.whatsapp.numero}</a>
          </li>
          {SITE.emails.map((e) => (
            <li class="flex gap-2">
              <Icon name="mdi:email-outline" class="size-5 shrink-0 text-secundario-400" aria-hidden="true" />
              <a href={`mailto:${e}`} itemprop="email" class="hover:text-secundario-300 break-all" aria-label={`Escribir a ${e}`}>{e}</a>
            </li>
          ))}
          <li class="flex gap-2">
            <Icon name="mdi:clock-outline" class="size-5 shrink-0 text-secundario-400" aria-hidden="true" />
            <span>{sede.horario}</span>
          </li>
        </ul>
      </address>
    </div>
  </div>

  <!-- Mapa de la sede -->
  <div class="contenedor pb-10">
    <iframe
      src={SITE.sedes[0].mapaEmbed}
      title={`Mapa de la sede de ${SITE.nombreCorto}: ${SITE.sedes[0].direccion}, ${SITE.sedes[0].ciudad}`}
      class="mx-auto h-64 w-full max-w-3xl rounded-marca-lg border border-white/10 grayscale-[35%]"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>

  <div class="border-t border-white/10">
    <div class="contenedor flex flex-col gap-3 py-5 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {anio} {SITE.nombre}. Todos los derechos reservados.
        {SITE.ruc && <span class="block sm:inline sm:ml-2">RUC {SITE.ruc}</span>}
      </p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {SITE.navegacionLegal.map((l) => (
          <li><a href={l.href} class="hover:text-secundario-300">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
