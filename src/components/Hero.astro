---
/**
 * Hero de la página de inicio: imagen de fondo optimizada, eslogan,
 * descripción y llamados a la acción.
 */
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { SITE } from '@/config/site';
import heroImg from '@/assets/hero.jpg';

export interface Props {
  /** Título principal (por defecto el eslogan). */
  titulo?: string;
  /** Subtítulo / descripción. */
  descripcion?: string;
}

const { titulo = SITE.eslogan, descripcion = SITE.descripcion } = Astro.props;
---

<section class="relative isolate flex min-h-[52vh] items-center overflow-hidden bg-primario-900 text-white lg:min-h-[60vh]">
  <!-- TODO: reemplazar src/assets/hero.jpg por una foto real (mín. 1920x1080) -->
  <Image
    src={heroImg}
    alt=""
    widths={[640, 1024, 1600, 1920]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
    quality={75}
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-primario-900/95 via-primario-900/80 to-primario-900/40" aria-hidden="true"></div>

  <div class="contenedor py-14 pb-24 lg:py-16 lg:pb-28">
    <div class="max-w-2xl animate-fade-up">
      <h1 class="text-4xl font-extrabold !text-secundario-400 sm:text-5xl lg:text-6xl">
        {titulo}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-white/85 sm:text-xl">{descripcion}</p>
    </div>
  </div>

  <!-- Franja de confianza -->
  <div class="absolute inset-x-0 bottom-0 hidden border-t border-white/10 bg-primario-900/70 backdrop-blur md:block">
    <ul class="contenedor grid grid-cols-3 divide-x divide-white/10 py-4 text-sm">
      {[
        { icono: 'mdi:shield-check-outline', texto: 'Trabajos con garantía escrita' },
        { icono: 'mdi:clock-fast', texto: 'Respuesta en menos de 24 horas' },
        { icono: 'mdi:map-marker-radius-outline', texto: 'Atención en todo el Perú' },
      ].map((i) => (
        <li class="flex items-center justify-center gap-2 px-4 text-white/85">
          <Icon name={i.icono} class="size-5 text-secundario-400" aria-hidden="true" />
          {i.texto}
        </li>
      ))}
    </ul>
  </div>
</section>
