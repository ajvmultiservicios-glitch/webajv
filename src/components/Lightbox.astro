---
/**
 * Lightbox accesible basado en <dialog>: se abre desde cualquier botón con
 * data-lightbox="<id>" y data-indice="<n>". Se cierra con Esc, con el botón
 * de cerrar o haciendo clic fuera de la imagen. Flechas ← → para navegar.
 */
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  id: string;
  fotos: { src: ImageMetadata; alt: string }[];
}

const { id, fotos } = Astro.props;

// Versiones optimizadas (máx. 1600 px) para mostrar ampliadas
const optimizadas = await Promise.all(
  fotos.map(async (f) => {
    const img = await getImage({ src: f.src, width: 1600, format: 'webp', quality: 80 });
    return { src: img.src, alt: f.alt };
  }),
);
---

<dialog
  id={`lightbox-${id}`}
  class="m-auto max-h-[100dvh] max-w-[100vw] bg-transparent p-0 backdrop:bg-black/90 open:flex open:items-center open:justify-center"
  aria-label="Visor de imágenes"
  data-fotos={JSON.stringify(optimizadas)}
>
  <div class="relative flex w-[100vw] max-w-6xl flex-col items-center p-4" data-contenido>
    <img
      src=""
      alt=""
      class="max-h-[82dvh] w-auto max-w-full rounded-marca object-contain shadow-2xl"
      data-imagen
    />
    <p class="mt-3 text-center text-sm text-white/85" data-pie></p>

    <button type="button" class="absolute right-4 top-4 inline-flex size-11 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/30" data-cerrar aria-label="Cerrar">
      <Icon name="mdi:close" class="size-6" aria-hidden="true" />
    </button>
    <button type="button" class="absolute left-2 top-1/2 -translate-y-1/2 inline-flex size-11 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/30" data-nav="-1" aria-label="Anterior">
      <Icon name="mdi:chevron-left" class="size-7" aria-hidden="true" />
    </button>
    <button type="button" class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex size-11 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/30" data-nav="1" aria-label="Siguiente">
      <Icon name="mdi:chevron-right" class="size-7" aria-hidden="true" />
    </button>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>('dialog[id^="lightbox-"]').forEach((dialogo) => {
    const id = dialogo.id.replace('lightbox-', '');
    const fotos: { src: string; alt: string }[] = JSON.parse(dialogo.dataset.fotos ?? '[]');
    const img = dialogo.querySelector<HTMLImageElement>('[data-imagen]')!;
    const pie = dialogo.querySelector<HTMLElement>('[data-pie]')!;
    let actual = 0;

    const mostrar = (i: number) => {
      actual = (i + fotos.length) % fotos.length;
      img.src = fotos[actual].src;
      img.alt = fotos[actual].alt;
      pie.textContent = `${fotos[actual].alt} (${actual + 1} / ${fotos.length})`;
    };

    document.querySelectorAll<HTMLElement>(`[data-lightbox="${id}"]`).forEach((btn) => {
      btn.addEventListener('click', () => {
        mostrar(Number(btn.dataset.indice ?? 0));
        dialogo.showModal();
      });
    });

    dialogo.querySelector('[data-cerrar]')?.addEventListener('click', () => dialogo.close());
    dialogo.querySelectorAll<HTMLButtonElement>('[data-nav]').forEach((b) =>
      b.addEventListener('click', () => mostrar(actual + Number(b.dataset.nav))),
    );
    // Clic fuera del contenido cierra el visor
    dialogo.addEventListener('click', (e) => {
      const contenido = dialogo.querySelector('[data-contenido]');
      if (e.target === dialogo || (e.target as HTMLElement).closest('[data-contenido]') === contenido && e.target === contenido) {
        dialogo.close();
      }
    });
    dialogo.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') mostrar(actual + 1);
      if (e.key === 'ArrowLeft') mostrar(actual - 1);
      // Esc lo gestiona <dialog> de forma nativa
    });
  });
</script>
